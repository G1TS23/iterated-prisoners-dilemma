# Copier en .env et adapter.

# --- LM Studio ---
LMSTUDIO_HOST=http://localhost:1234

# Modèle qui incarne les 3 personas IA (empathique/calculateur/rancunier ->
# config/personas.yaml). Un seul modèle par défaut : la variable étudiée ici
# est le PROMPT (persona), pas le modèle -- cf. sujet. Mets plusieurs modèles
# séparés par des virgules si tu veux comparer aussi l'effet du modèle.
LLM_MODELS=qwen2.5-3b-instruct

# --- Tournoi ---
N_TURNS=100
N_REPEATS=1          # répétitions par paire (utile surtout pour les paires impliquant "random")
SEED=42

# --- Reproductibilité des appels LLM ---
TEMPERATURE=0.2       # >0 : un agent IA peut varier légèrement d'un tour à l'autre, comme un humain
MAX_TOKENS=96         # un peu plus que Trivial Pursuit : on laisse de la place à une justification courte
