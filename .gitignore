# --- Python ---
.venv/
__pycache__/
*.pyc
.env

# --- Data lake (médaillon) : ne pas versionner les gros fichiers générés ---
data/bronze/*
data/silver/*
data/gold/*
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
# Bronze + silver (Parquet) versionnés : permettent de reconstruire le gold avec
# dbt et de retrouver les chiffres du rapport SANS LM Studio ni 1h30 de calcul.
# Le gold (gold.duckdb) reste ignoré : il est reconstruit par `dbt build`.
!data/bronze/turns_raw.parquet
!data/silver/turns.parquet

# --- dbt ---
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# --- divers ---
.DS_Store
.idea/
.streamlit/secrets.toml
